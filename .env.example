# Application
APP_NAME="Ethiopian IT Park CRM"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5174

# Ports
NGINX_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_DASHBOARD_PORT=8025
FRONTEND_PORT=5174

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_DATABASE=crm_db
DB_USERNAME=crm_user
DB_PASSWORD=crm_secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailpit
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="crm@itpark.gov.et"
MAIL_FROM_NAME="Ethiopian IT Park CRM"
